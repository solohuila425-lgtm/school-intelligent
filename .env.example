ENVIRONMENT=development
DEFAULT_COUNTRY_CODE=CO
DEFAULT_CURRENCY=COP
DATABASE_URL=postgresql+psycopg://erp:password@localhost:5432/erp_educativo
REDIS_URL=redis://localhost:6379/0
API_BASE_URL=http://localhost:8000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,https://school-intelligent-jet.vercel.app
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_TENANT_PER_MINUTE=300
RATE_LIMIT_PER_IP_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_IP_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60

# Real agent worker configuration. Never commit actual keys.
ERP_REDIS_URL=redis://localhost:6379/0
AGENT_INPUT_STREAM=class:transcript:chunks
AGENT_AUDIO_STREAM=class:audio:chunks
AGENT_OUTPUT_STREAM=class:agent:results
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# Production notes:
# - set ENVIRONMENT=production only with a real PostgreSQL URL and a secure JWT secret
# - keep REDIS_URL configured whenever RATE_LIMIT_ENABLED=true in prod
# - CORS_ORIGINS should be a comma-separated allowlist, never "*"
